<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Commission_Rate_Must_Be_Valid</fullName>
    <active>true</active>
    <errorConditionFormula>Commission_Rate__c &lt; 0  || Commission_Rate__c &gt; 100</errorConditionFormula>
    <errorDisplayField>Commission_Rate__c</errorDisplayField>
    <errorMessage>Commission rate must be between 0 and 100 percent</errorMessage>
</ValidationRule>
